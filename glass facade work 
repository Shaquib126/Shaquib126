/* Gallery Styles */
.gallery {
  padding: 60px 10%;
  background-color: #fff;
  text-align: center;
}

.gallery h2 {
  margin-bottom: 40px;
  color: #2c3e50;
}

.gallery-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
  gap: 15px;
}

.gallery-item {
  position: relative;
  overflow: hidden;
  border-radius: 8px;
  height: 250px;
}

.gallery-item img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.5s ease;
}

.overlay {
  position: absolute;
  bottom: -100%;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(52, 152, 219, 0.8);
  color: white;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: bottom 0.4s ease;
}

.gallery-item:hover img {
  transform: scale(1.1);
}

.gallery-item:hover .overlay {
  bottom: 0;
}
